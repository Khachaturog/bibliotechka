# Apache конфигурация для API и красивых URL
# Поддерживает как прямые файлы, так и роутинг через api/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Корневой URL / → index-seo.php (до проверки существующих файлов)
    RewriteRule ^$ /index-seo.php [L]

    # sitemap.xml → sitemap.php (динамический с данными из БД)
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # Исключаем существующие файлы и директории (они обрабатываются напрямую)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Обработка API запросов к /api/v1/*
    RewriteCond %{REQUEST_URI} ^/api/v1/([^/]+)/list/?(\?.*)?$
    RewriteCond %{DOCUMENT_ROOT}/api/v1/%1/list.php -f
    RewriteRule ^api/v1/([^/]+)/list/?$ /api/v1/$1/list.php [L,QSA]

    RewriteCond %{REQUEST_URI} ^/api/v1/([^/]+)/([^/]+)/authors/?(\?.*)?$
    RewriteCond %{DOCUMENT_ROOT}/api/v1/%1/authors.php -f
    RewriteRule ^api/v1/([^/]+)/([^/]+)/authors/?$ /api/v1/$1/authors.php [L,QSA]

    RewriteCond %{REQUEST_URI} ^/api/v1/([^/]+)/?(\?.*)?$
    RewriteCond %{DOCUMENT_ROOT}/api/v1/%1/index.php -f
    RewriteRule ^api/v1/([^/]+)/?$ /api/v1/$1/index.php [L,QSA]

    RewriteCond %{REQUEST_URI} ^/api/v1/([^/]+)/?(\?.*)?$
    RewriteCond %{DOCUMENT_ROOT}/api/v1/%1.php -f
    RewriteRule ^api/v1/([^/]+)/?$ /api/v1/$1.php [L,QSA]

    # Fallback для остальных запросов к API
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ /api/index.php?path=$1 [QSA,L]

    # Красивые URL карточек: /card/gajd-po-tekstam-v-interfejse-001
    RewriteCond %{REQUEST_URI} ^/card/([a-z0-9-]+)/?$
    RewriteRule ^card/([a-z0-9-]+)/?$ /detail-seo.php?url_seo_yandex=$1 [QSA,L]

    # Красивые URL групп: /designsystem
    RewriteCond %{REQUEST_URI} !^/(index\.html|index-seo\.php|group\.html|detail\.html|api|images|css|js|scripts|other|database|data|cache|partials|detail-seo\.php|group-seo\.php|router\.php|sitemap\.xml|robots\.txt)
    RewriteRule ^([^/]+)/?$ /group-seo.php?slug=$1 [QSA,L]
</IfModule>

# 404: отдавать отдельную страницу ошибки
ErrorDocument 404 /404.html

# Заголовки кэширования и CORS
<IfModule mod_headers.c>
    # HTML-страницы и PHP — 1 час
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Статические ресурсы — 1 год (immutable т.к. имена файлов не меняются без деплоя)
    <FilesMatch "\.(css|js|woff2|woff|ttf|otf|svg|png|jpg|jpeg|webp|ico|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CORS для API
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type"
</IfModule>
