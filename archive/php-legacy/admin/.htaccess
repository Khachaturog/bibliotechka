# Запрет прямого доступа к конфигурации и служебным файлам
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>
<Files "login-helpers.php">
    Require all denied
</Files>

# Запрет доступа к папке data (попытки входа, rate limit)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>
