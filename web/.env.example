# Local + CI (GitHub Actions secrets must use these exact names):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#
# Do not commit real keys. Anon key is read-only (RLS published SELECT).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public URL base for assets and Router basename.
#   /bibliotechka-4/  — GH Pages project preview (until DNS cutover)
#   /                 — bibliotechka.site after DNS → GitHub Pages
# CI pages.yml uses /bibliotechka-4/ until cutover (cannot dual-serve both
# with one absolute base; nested routes break a relative base).
VITE_BASE=/
