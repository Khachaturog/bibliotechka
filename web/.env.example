# Local + CI (GitHub Actions secrets must use these exact names):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#
# Do not commit real keys. Anon key is read-only (RLS published SELECT).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public URL base for assets and Router basename.
#   /bibliotechka-4/  — GitHub Pages project preview (khachaturog.github.io/bibliotechka-4/)
#   /                 — domain root (bibliotechka.site after DNS cutover)
# CI pages.yml sets /bibliotechka-4/ until cutover.
VITE_BASE=/
